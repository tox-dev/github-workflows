#!/usr/bin/env bash
# release-creator 3.1.0 adds new-contributors; until it ships, the tests record the call and run the rest for real.
set -euo pipefail
if [[ "$1" == new-contributors ]]; then
  printf '%s\n' "${@:2}" >"$RUNNER_TEMP/new-contributors"
  exit 0
fi
exec "$(dirname "$0")/../../.release-tools/bin/release-creator" "$@"
